data_error <- dataT %>%
mutate(abs_residual = abs(residuals(model)))
error_model <- lm(abs_residual ~ VI + city, data = data_error)
vi_emm <- emmeans(error_model, ~ VI)
vi_pairs <- pairs(vi_emm, adjust = "tukey")
df_plot <- as.data.frame(vi_emm)
#plot it.
ggplot(df_plot, aes(x = reorder(VI, emmean), y = emmean)) +
geom_hline(yintercept = seq(0, max(df_plot$upper.CL), by = 0.05),
color = "grey", linewidth = 0.5) +
geom_pointrange(aes(ymin = lower.CL, ymax = upper.CL),
color = "#2c3e50", size = 0.7, linewidth = 0.9) +
labs(x = "Vegetation Index",
y = "Estimated Marginal Mean of Absolute Error",
caption = "95% confidence intervals adjusted for city-level differences") +
theme_classic(base_size = 13) +
theme(axis.text = element_text(color = "black"),
axis.title.x = element_text(margin = margin(t = 12)),
axis.title.y = element_text(margin = margin(r = 12)),
plot.caption = element_text(size = 9, face = "italic", color = "gray30"))
